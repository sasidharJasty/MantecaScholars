: "api.user", "pk": 21, "fields": {"password": "pbkdf2_sha256$600000$CUTG1BM27A0k98UWaJa4BK$DmYLmodeKmC/DZQ0X8zUBJIH3kv57N3BhPdyvRCv1XY=", "last_login": null, "is_superuser": false, "username": "js8782216@gmail.com", "first_name": "Jasnoor", "last_name": "Kaur", "email": "js8782216@gmail.com", "is_staff": false, "is_active": true, "date_joined": "2026-10-01T21:26:27.255Z", "role": "student", "full_name": "", "avatar_url": "", "onboarding_completed": false, "member_id": "610088682@musd.net", "account_status": "pending", "groups": [], "user_permissions": []}}, {"model": "api.program", "pk": 1, "fields": {"name": "System Admin", "description": "Internal program for system administration", "website": "https://admin.internal", "info_content": "", "created_at": "2026-09-09T05:33:04.672Z"}}, {"model": "api.program", "pk": 2, "fields": {"name": "World Scholars", "description": "The World Scholar’s Cup is an international academic program and competition that brings together students from different countries to explore interdisciplinary themes through team debates, collaborative writing, quizzes, and knowledge challenges. Although academic achievement is central to the experience, the program’s broader value lies in encouraging students to consider unfamiliar perspectives and engage with global issues alongside peers from different cultural and educational backgrounds. Regional and global rounds create a distinctly international environment in which participants represent not only their schools, but also the ideas, experiences, and traditions of their communities.\nEqually important, the World Scholar’s Cup serves as a platform for international friendship and networking. Students build relationships through teamwork, cultural exchange, social activities, and informal conversations that extend well beyond the competitive events. These interactions help participants develop intercultural awareness, confidence, diplomacy, and communication skills while forming connections with ambitious young people from around the world. In this sense, the program functions as a miniature global forum: academic competition provides the structure, but its lasting impact often comes from the international relationships, shared experiences, and cross-border networks created along the way.", "website": "https://www.scholarscup.org", "info_content": "", "created_at": "2026-09-16T17:17:53.558Z"}}, {"model": "api.program", "pk": 3, "fields": {"name": "Speech & Debate", "description": "Speech and Debate is a competitive academic activity that helps students develop persuasive communication, critical thinking, research, and public-speaking skills. Through events such as prepared speeches, impromptu speaking, interpretation, and structured debate, participants learn to construct arguments, respond thoughtfully under pressure, and communicate complex ideas with clarity and confidence. Competitions challenge students to engage deeply with current affairs, ethics, public policy, and global issues while considering multiple perspectives.\nBeyond competition, Speech and Debate fosters a broad community of articulate, engaged students who connect through tournaments, conferences, and shared intellectual interests. Participants exchange ideas with peers from different schools, regions, and backgrounds, building relationships grounded in respectful disagreement and mutual understanding. These experiences strengthen leadership, diplomacy, teamwork, and cross-cultural communication, creating a valuable network of young people prepared to participate meaningfully in academic, professional, and civic life.", "website": "https://www.speechanddebate.org", "info_content": "", "created_at": "2026-09-16T17:45:10.285Z"}}, {"model": "api.roster", "pk": 1, "fields": {"user": 1, "program": 1, "is_team_leader": false, "is_muted": false, "joined_at": "2026-09-09T06:04:26.513Z"}}, {"model": "api.roster", "pk": 2, "fields": {"user": 2, "program": 2, "is_team_leader": false, "is_muted": false, "joined_at": "2026-09-16T17:49:33.634Z"}}, {"model": "api.roster", "pk": 3, "fields": {"user": 6, "program": 2, "is_team_leader": false, "is_muted": false, "joined_at": "2026-09-16T17:50:34.871Z"}}, {"model": "api.roster", "pk": 4, "fields": {"user": 4, "program": 2, "is_team_leader": false, "is_muted": false, "joined_at": "2026-09-16T17:55:40.649Z"}}, {"model": "api.roster", "pk": 5, "fields": {"user": 4, "program": 3, "is_team_leader": false, "is_muted": false, "joined_at": "2026-09-16T17:55:50.430Z"}}, {"model": "api.chatroom", "pk": 1, "fields": {"program": 1, "name": "Admin HQ", "is_locked": false, "created_at": "2026-09-09T05:33:04.993Z"}}, {"model": "api.chatmessage", "pk": 1, "fields": {"room": 1, "user": 1, "content": "hi", "sender_name": "sasidhar", "is_deleted": false, "is_pinned": false, "deleted_by": null, "reply_to_id": null, "created_at": "2026-09-09T06:10:36.032Z"}}, {"model": "api.chatmessage", "pk": 2, "fields": {"room": 1, "user": 1, "content": "test", "sender_name": "sasidhar", "is_deleted": false, "is_pinned": false, "deleted_by": null, "reply_to_id": null, "created_at": "2026-09-09T06:13:19.137Z"}}, {"model": "api.websitecontent", "pk": 1, "fields": {"key": "team_page", "content": {"boardMembers": [{"name": "Miles Lima", "title": "Founder, President and Director of Programs", "roles": ["Program Coordinator: World Scholars Cup"], "email": "mlima@mantecascholars.org"}, {"name": "Aditi Malgunde", "title": "Director of Records and Archives", "roles": [], "email": "amalgunde@mantecascholars.org"}, {"name": "Isabel Aquinde", "title": "Director of the Brand", "roles": [], "email": "iaquinde@mantecascholars.org"}, {"name": "Sagar Shah", "title": "Director of Finance and Asset Management", "roles": [], "email": "sshah@mantecascholars.org"}, {"name": "Snehal Bhaira", "title": "Director of Fundraising and Executive Development Specialist", "roles": [], "email": "sbhaira@mantecascholars.org"}, {"name": "Shaurya Khairmode", "title": "Director-General"